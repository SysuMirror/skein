# Skein control plane — environment example
#
# Copy to a file only your operator can read (mode 600), e.g. /etc/skein/env, and point the
# systemd unit's EnvironmentFile= at it — or `cp .env.example .env` for docker compose.
# Every key is optional: with this file empty the control plane runs in token mode.
# Explanations and defaults are repeated in docs/configuration.md.

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
# SQLite database and content-addressed blobs (transcripts). Back both up together.
SKEIN_DB=/var/lib/skein/skein.db
SKEIN_BLOB_ROOT=/var/lib/skein/blobs
# Listen address. Put a reverse proxy in front for TLS.
SKEIN_HOST=127.0.0.1
SKEIN_PORT=7800
# Where this control plane is reachable from the control plane itself (the watchdog uses it).
SKEIN_CONTROL_URL=http://127.0.0.1:7800
# The master token: machines use it for /internal/*, nodes for registration, the CLI for
# management. Generate with: openssl rand -hex 32
SKEIN_TOKEN=

# ---------------------------------------------------------------------------
# Login (one human login method; leave everything empty for token mode)
# ---------------------------------------------------------------------------
# Local accounts (email + password, created by an owner with the CLI):
# SKEIN_LOCAL_LOGIN=1
#
# Or an external login provider (these three keys enable it; provider default: unisso):
# SKEIN_SSO_PROVIDER=unisso
# SKEIN_SSO_BASE=https://sso.example.com
# SKEIN_SSO_CLIENT_ID=
# SKEIN_SSO_CLIENT_SECRET=
# SKEIN_SSO_COOKIE_NAME=
# SKEIN_COOKIE_DOMAIN=        # "host" = host-only cookie; empty = take it from the provider
# SKEIN_SSO_REQUIRE_INTERNAL=1
#
# First-time identities: admins (as reported by the provider) are provisioned
# automatically. Set this to "member" to also provision everybody else as a member:
# SKEIN_AUTH_AUTO_ROLE=
#
# Skein-issued sessions (local accounts and token mode):
# SKEIN_SESSION_TTL_HOURS=168
# SKEIN_SESSION_COOKIE_NAME=skein_session
# SKEIN_SESSION_COOKIE_SECURE=1   # set 0 only for plain-HTTP demos

# ---------------------------------------------------------------------------
# Assistants (the public API at /api/v1)
# ---------------------------------------------------------------------------
# Base URL used in ticket links and callbacks. Empty = no links in API responses.
SKEIN_PUBLIC_URL=
# Requests per minute per assistant credential.
# SKEIN_API_RATE_LIMIT=60
# Also accept model-call trace records from assistants (POST /api/v1/llm/calls).
# SKEIN_API_TRACE=0
# Expose /docs and /openapi.json (off by default: the internal routes need not be public).
# SKEIN_API_DOCS=0
# Declare credentials here instead of issuing them from the console. Declared ones follow
# the file: change the key to rotate, remove the entry to revoke. Generate keys with:
#   python -m skein assistant key
# SKEIN_ASSISTANTS=[{"name":"forum-bot","purpose":"turns forum posts into tickets","key":"skein_at_..."}]

# ---------------------------------------------------------------------------
# Repositories and pull requests
# ---------------------------------------------------------------------------
# How to identify a platform's repository when the worker's git remote is not a GitHub URL
# (the node can also resolve it with its own REPO_MAP):
# SKEIN_PLATFORM_REPOS={"forum":"/srv/repos/forum"}
# Code hosting provider (see skein/forge.py): github
# SKEIN_FORGE=github
# Token used to open draft PRs. Fine-grained token, "Contents: read" and
# "Pull requests: read and write" on the repositories below.
# SKEIN_GITHUB_TOKEN=
# platform → repository (PR base branch optional; empty = develop if it exists, else default)
# SKEIN_GITHUB_REPOS={"forum":{"slug":"example-org/forum"},"api":"example-org/api"}
# Force one base branch for every repository (wins over the per-repo value):
# SKEIN_GITHUB_BASE=
# GitHub Enterprise: https://github.example.com/api/v3
# SKEIN_GITHUB_API=https://api.github.com
# SKEIN_GITHUB_PR_DRAFT=1
# Test environments linked from a ticket once its PR is on the integration branch:
# SKEIN_TEST_ENVS={"example-org/forum":"https://forum-test.example.com"}

# ---------------------------------------------------------------------------
# Console Agent (optional; without a model gateway it says so and stays off)
# ---------------------------------------------------------------------------
# SKEIN_LLM_BASE=https://api.example.com/v1
# SKEIN_LLM_KEY=
# SKEIN_AGENT_MODEL=deepseek-chat

# ---------------------------------------------------------------------------
# Watchdog (external control loop; run deploy/systemd/skein-watchdog.service)
# ---------------------------------------------------------------------------
# SKEIN_WATCHDOG=1
# SKEIN_WATCHDOG_INTERVAL=300
# SKEIN_WATCHDOG_TICKETS=1          # turn watchdog signals into tickets (needs CONTROL_URL + TOKEN)
# SKEIN_WATCHDOG_DISPATCH=0
# SKEIN_DAILY_TICKET_HOUR=-1        # -1 = no daily review ticket
# SKEIN_TICKET_DAILY_CAP=5

# ---------------------------------------------------------------------------
# Scheduled jobs (driver) — rarely needed; see docs/control-plane.md
# ---------------------------------------------------------------------------
# SKEIN_DRIVER=0
# SKEIN_SCHEDULES=[]
# SKEIN_JOB_COMMANDS={}
# SKEIN_JOBS_FILE=
# SKEIN_JOB_TIMEOUT=14400

# ---------------------------------------------------------------------------
# Optional integration: chat proxy in front of an external chat service
# ---------------------------------------------------------------------------
# SKEIN_QA_CHAT_UPSTREAM=http://127.0.0.1:8000
# SKEIN_ASSERTION_KEY=            # signs the short-lived x-skein-user identity header

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
# text (default) or json (one object per line)
# SKEIN_LOG_FORMAT=text
