# Skein node agent — environment example
#
# The node agent runs on a machine that will execute tickets with a coding agent. It dials
# OUT to the control plane; nothing needs to be reachable from the outside. Install it with
# deploy/pod/setup.sh + deploy/pod/install-supervisor.sh (see deploy/pod/README.md).

# Where the control plane's node channel is. Either give CONTROLLER_URL directly, or give
# SKEIN_CONTROL_URL and the agent derives ws(s)://<same host>/api/agent/channel from it.
CONTROLLER_URL=ws://127.0.0.1:7800/api/agent/channel
SKEIN_CONTROL_URL=http://127.0.0.1:7800

# The master token (the same SKEIN_TOKEN as the control plane's environment file). The
# agent uses it to register and to upload transcripts. Workers never see it.
SKEIN_TOKEN=
# Registration token for the node channel. Defaults to SKEIN_TOKEN; only set it when the
# control plane expects a different value (it does not, today).
# AGENT_TOKEN=

# Stable identity for this node. Defaults to n-<hostname>.
NODE_ID=
NODE_NAME=

# Which platforms this node serves, comma separated. A platform is a repository the node
# has cloned; tickets are dispatched by platform.
PLATFORMS=forum,api

# platform → local clone (must be a git checkout the node can push from).
# Empty values are fine when only one platform is configured.
REPO_MAP={"forum":"/home/node/repos/forum","api":"/home/node/repos/api"}

# How many workers may run at once on this node.
MAX_WORKERS=2

# The coding agent executable. It must be installed and configured for the user that runs
# the node agent (see docs/worker-runtime.md). Defaults to "claude".
CLAUDE_BIN=claude

# Push the worker's branch to origin when it commits (the control plane then opens the
# draft PR). Set to 0 to keep branches local.
PUSH_BRANCH=1

# Optional process sandbox around each worker (Linux with systemd-run; see docs/sandbox.md).
# SANDBOX_ENABLED=0

# Optional extra tools to allow inside workers (space separated, replaces the default allow list).
# WORKER_ALLOWED_TOOLS=

# Set when the agent runs inside a container: relaxes the worker sandbox expectations.
# IS_SANDBOX=1
# WORKER_FULL_BYPASS=1
